{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  'internalChecksFilter': 'strict',
  // 'minimumReleaseAge': '7 days', // disabled for testing
  'branchPrefix': 'renovate/',
  // You can build the email with this info: curl -s https://api.github.com/users/odgbot%5Bbot%5D | grep -E '"id"|"login"' — format: <id>+<slug>[bot]@users.noreply.github.com
  'gitAuthor': 'odgbot[bot] <319464553+odgbot[bot]@users.noreply.github.com>',
  'gitIgnoredAuthors': [
    '319464553+odgbot[bot]@users.noreply.github.com',
    '317879433+alex-ocmbot[bot]@users.noreply.github.com',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  automerge: false,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },
  packageRules: [
    {
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      // gardener/cc-utils is intentionally pinned to @v1 as a floating major
      // tag — frequent updates, deliberately unpinned. Disable to avoid
      // constant SHA-bump PRs.
      matchManagers: ['github-actions'],
      matchDepNames: ['gardener/cc-utils'],
      enabled: false,
    },
    {
      // gateway-helm and gateway tags use a v-prefix (v1.8.x).
      // versionCompatibility captures the 'v' as compatibility so Renovate
      // restores it when writing back the new version.
      // pinDigests is disabled because digests are already pinned inline in
      // base-component.yaml via the combined imageRef+version regex managers.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
      ],
      versionCompatibility: '^(?<compatibility>v?)(?<version>.+)$',
      versioning: 'semver',
      pinDigests: false,
    },
    {
      // envoy tags are semver. pinDigests disabled — digest is pinned inline
      // in the combined imageRef+version regex manager.
      matchDepNames: ['docker.io/envoyproxy/envoy'],
      versioning: 'semver',
      pinDigests: false,
    },
    {
      // Disable digest-only and pinDigest update types for all envoy deps.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
        'docker.io/envoyproxy/envoy',
      ],
      matchUpdateTypes: ['digest', 'pinDigest'],
      enabled: false,
    },
    {
      // Bundle gateway-helm + gateway into a single PR.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
      ],
      groupName: 'envoy-gateway',
    },
    {
      // envoy proxy gets its own PR.
      matchDepNames: ['docker.io/envoyproxy/envoy'],
      groupName: 'envoy-proxy',
    },
  ],
  customManagers: [
    {
      // Track the Renovate version used in the workflow
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml'],
      matchStrings: ["renovate-version:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
    // -- OCM component descriptor: combined imageReference + version (single manager per resource) --
    {
      // gateway-helm: updates imageReference tag+digest AND version field in one pass.
      // Single manager avoids the autoreplace-verify failure that occurs when separate
      // imageRef and version managers each try to re-extract after their own update.
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference: docker\\.io/envoyproxy/gateway-helm:(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\n    type: ociRegistry\\n  extraIdentity:\\n    type: helmChart/v1\\n  name: envoy-gateway\\n  relation: external\\n  type: helmChart/v1\\n  version: [^\\s]+',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway-helm',
      autoReplaceStringTemplate: 'imageReference: docker.io/envoyproxy/gateway-helm:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\n    type: ociRegistry\n  extraIdentity:\n    type: helmChart/v1\n  name: envoy-gateway\n  relation: external\n  type: helmChart/v1\n  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    {
      // gateway (ociImage): updates imageReference tag+digest AND version field in one pass.
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference: docker\\.io/envoyproxy/gateway:(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\n    type: ociRegistry\\n  name: envoy-gateway\\n  relation: external\\n  type: ociImage\\n  version: [^\\s]+',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway',
      autoReplaceStringTemplate: 'imageReference: docker.io/envoyproxy/gateway:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\n    type: ociRegistry\n  name: envoy-gateway\n  relation: external\n  type: ociImage\n  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    {
      // envoy proxy: updates imageReference tag+digest AND version field in one pass.
      // currentValue captures the semver part WITHOUT the 'distroless-' prefix
      // so that Renovate can look up v1.38.3 -> v1.39.0 via semver.
      // autoReplaceStringTemplate re-adds 'distroless-' only in the imageReference.
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference: docker\\.io/envoyproxy/envoy:distroless-(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\n    type: ociRegistry\\n  name: envoy-proxy\\n  relation: external\\n  type: ociImage\\n  version: [^\\s]+',
      ],
      depNameTemplate: 'docker.io/envoyproxy/envoy',
      autoReplaceStringTemplate: 'imageReference: docker.io/envoyproxy/envoy:distroless-{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\n    type: ociRegistry\n  name: envoy-proxy\n  relation: external\n  type: ociImage\n  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    // -- extension-definitions.yaml: cross-file sync with gateway-helm --
    {
      // artefact version for envoy-gateway in extension-definitions.
      // Anchors on 'artefact:' to skip the mappings entry which also
      // has 'name: envoy-gateway' but tracks an unrelated ODG version.
      customType: 'regex',
      managerFilePatterns: ['extension-definitions.yaml'],
      matchStrings: [
        '(?<context>artefact:\\s*\\n\\s*name:\\s*envoy-gateway\\s*\\n\\s*)version:\\s*(?<currentValue>[^\\s]+)',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway-helm',
      autoReplaceStringTemplate: '{{{context}}}version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
  ],
}
