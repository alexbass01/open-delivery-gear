{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  'internalChecksFilter': 'strict',
  // 'minimumReleaseAge': '7 days', // disabled for testing
  'branchPrefix': 'renovate/',
  // You can build the email with this info: curl -s https://api.github.com/users/odgbot%5Bbot%5D | grep -E '"id"|"login"' — format: <id>+<slug>[bot]@users.noreply.github.com
  'gitAuthor': 'odgbot[bot] <319464553+odgbot[bot]@users.noreply.github.com>',
  'gitIgnoredAuthors': [
    '319464553+odgbot[bot]@users.noreply.github.com',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  automerge: false,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },
  packageRules: [
    {
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      // gardener/cc-utils is intentionally pinned to @v1 as a floating major
      // tag — frequent updates, deliberately unpinned. Disable to avoid
      // constant SHA-bump PRs.
      matchManagers: ['github-actions'],
      matchDepNames: ['gardener/cc-utils'],
      enabled: false,
    },
    {
      // gateway-helm and gateway tags use a v-prefix (v1.8.x).
      // versionCompatibility captures the 'v' as compatibility so Renovate
      // restores it when writing back the new version.
      // pinDigests is disabled and digest/pinDigest update types are blocked
      // because these images already have digests pinned manually in
      // base-component.yaml; digest-update collisions with version upgrades
      // in the same grouped branch cause "Ignoring upgrade collision" errors.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
        'docker.io/envoyproxy/envoy-version',
      ],
      versionCompatibility: '^(?<compatibility>v?)(?<version>.+)$',
      versioning: 'semver',
      pinDigests: false,
    },
    {
      // Disable digest refresh and pin updates for envoy deps to prevent
      // collisions with version upgrades in the same grouped branch.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
        'docker.io/envoyproxy/envoy-version',
        'docker.io/envoyproxy/envoy',
      ],
      matchUpdateTypes: ['digest', 'pinDigest'],
      enabled: false,
    },
    {
      // envoy tags use a distroless- prefix (distroless-v1.38.x).
      // versionCompatibility captures 'distroless-' as compatibility so the
      // correct tag (distroless-v1.39.0) is selected and the correct digest
      // is looked up. The version field uses a separate depName
      // (envoy-version) with a v?-only versionCompatibility rule.
      matchDepNames: ['docker.io/envoyproxy/envoy'],
      versionCompatibility: '^(?<compatibility>distroless-)?(?<version>.+)$',
      versioning: 'semver',
      pinDigests: false,
    },
    {
      // Bundle gateway-helm + gateway into a single PR.
      matchDepNames: [
        'docker.io/envoyproxy/gateway-helm',
        'docker.io/envoyproxy/gateway',
      ],
      groupName: 'envoy-gateway',
    },
    {
      // Bundle envoy image + version into a single PR.
      matchDepNames: [
        'docker.io/envoyproxy/envoy',
        'docker.io/envoyproxy/envoy-version',
      ],
      groupName: 'envoy-proxy',
    },
  ],
  customManagers: [
    {
      // Track the Renovate version used in the workflow
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml'],
      matchStrings: ["renovate-version:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
    // -- OCM component descriptor: imageReference lines (tag + digest) --
    {
      // gateway-helm: imageReference gets depName:tag@digest
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference:\\s*(?<depName>docker\\.io/envoyproxy/gateway-helm):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      autoReplaceStringTemplate: 'imageReference: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}',
      datasourceTemplate: 'docker',
    },
    {
      // gateway (ociImage): imageReference gets depName:tag@digest
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference:\\s*(?<depName>docker\\.io/envoyproxy/gateway):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      autoReplaceStringTemplate: 'imageReference: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}',
      datasourceTemplate: 'docker',
    },
    {
      // envoy proxy: imageReference gets depName:distroless-tag@digest
      // The distroless- prefix stays in currentValue so versionCompatibility
      // selects the correct tag (distroless-v1.39.0) and looks up the
      // correct digest. The version field uses a separate depName
      // (envoy-version) with packageNameTemplate pointing to the same
      // Docker image, so it gets newValue=v1.39.0 (without distroless-).
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference:\\s*(?<depName>docker\\.io/envoyproxy/envoy):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      autoReplaceStringTemplate: 'imageReference: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}',
      datasourceTemplate: 'docker',
    },
    // -- OCM component descriptor: version lines (no digest) --
    {
      // gateway-helm version field, identified by "type: helmChart/v1" on the line before
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        '(?<context>\\n  type:\\s*helmChart/v1\\n)  version:\\s*(?<currentValue>[^\\s]+)',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway-helm',
      autoReplaceStringTemplate: '{{{context}}}  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    {
      // gateway (ociImage) version field, identified by name+type combo
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        '(?<context>\\n  name:\\s*envoy-gateway\\n  relation:\\s*external\\n  type:\\s*ociImage\\n)  version:\\s*(?<currentValue>[^\\s]+)',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway',
      autoReplaceStringTemplate: '{{{context}}}  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    {
      // envoy proxy version field, identified by name+type combo.
      // Uses a separate depName (envoy-version) with packageNameTemplate
      // pointing to the same Docker image. This avoids upgrade collisions
      // with the imageReference regex (which gets newValue=distroless-vX.Y.Z
      // while this gets newValue=vX.Y.Z). Both are grouped via groupName.
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        '(?<context>\\n  name:\\s*envoy-proxy\\n  relation:\\s*external\\n  type:\\s*ociImage\\n)  version:\\s*(?<currentValue>[^\\s]+)',
      ],
      depNameTemplate: 'docker.io/envoyproxy/envoy-version',
      packageNameTemplate: 'docker.io/envoyproxy/envoy',
      autoReplaceStringTemplate: '{{{context}}}  version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
    // -- extension-definitions.yaml: cross-file sync with gateway-helm --
    {
      // artefact version for envoy-gateway in extension-definitions.
      // Anchors on 'artefact:' to skip the mappings entry which also
      // has 'name: envoy-gateway' but tracks an unrelated ODG version.
      customType: 'regex',
      managerFilePatterns: ['extension-definitions.yaml'],
      matchStrings: [
        '(?<context>artefact:\\s*\\n\\s*name:\\s*envoy-gateway\\s*\\n\\s*)version:\\s*(?<currentValue>[^\\s]+)',
      ],
      depNameTemplate: 'docker.io/envoyproxy/gateway-helm',
      autoReplaceStringTemplate: '{{{context}}}version: {{{newValue}}}',
      datasourceTemplate: 'docker',
    },
  ],
}
