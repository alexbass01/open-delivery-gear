{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  'minimumReleaseAge': '7 days',
  'internalChecksFilter': 'strict',
  'branchPrefix': 'renovate/',
  'gitAuthor': 'ocmbot[bot] <125909804+ocmbot[bot]@users.noreply.github.com>',
  'gitIgnoredAuthors': [
    '125909804+ocmbot[bot]@users.noreply.github.com',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  automerge: true,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: true,
  },
  packageRules: [
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      automerge: true,
    },
    {
      isVulnerabilityAlert: true,
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      // gardener/cc-utils is intentionally pinned to @v1 as a floating major
      // tag — frequent updates, deliberately unpinned. Disable to avoid
      // constant SHA-bump PRs.
      matchManagers: ['github-actions'],
      matchDepNames: ['gardener/cc-utils'],
      enabled: false,
    },
    {
      // OCM base-component: only automerge patch updates
      matchFileNames: ['.ocm/base-component.yaml'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      // OCM base-component: require manual review for minor & major
      matchFileNames: ['.ocm/base-component.yaml'],
      matchUpdateTypes: ['minor', 'major'],
      automerge: false,
    },
    {
      // OCM base-component: use semver versioning to preserve the v-prefix
      // in Docker tags (the default docker versioning strips it).
      matchFileNames: ['.ocm/base-component.yaml'],
      versioning: 'semver',
    },
  ],
  postUpgradeTasks: {
    // Renovate writes @sha256:... to both imageReference: and version:.
    // Strip it from version: — OCM expects a plain semver there.
    commands: [
      'sed -i -E "s/^([[:space:]]*version:[[:space:]]+[^@[:space:]]+)@sha256:[a-fA-F0-9]+/\\1/" .ocm/base-component.yaml',
    ],
    fileFilters: ['.ocm/base-component.yaml'],
    executionMode: 'branch',
  },
  customManagers: [
    {
      // Track the Renovate container image version used in the validate job
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml'],
      matchStrings: ['image: ghcr.io/renovatebot/renovate:(?<currentValue>[^@\\s]+)'],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
    {
      // Track external OCI images in OCM component descriptors.
      // A single pattern captures depName + currentDigest from imageReference:
      // and currentValue from the version: field further down in the same block.
      // postUpgradeTasks strips the digest Renovate appends to version:.
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference:\\s*(?<depName>[^:\\s]+):[^@\\s]+(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\\s\\S]{0,500}?\\n\\s*version:\\s*(?<currentValue>[^@\\s]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
